# Server-side only. Copy to `.env.server` (gitignored). NEVER goes in the app.
#
# The service_role / secret key BYPASSES every row-level security policy.
# Anyone holding it can read and write every row belonging to every player.
# It belongs in the tick worker and the photo-deletion job, nowhere else.
# Do not paste it into a chat window, a commit, or a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2, for the photo bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
