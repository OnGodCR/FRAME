# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# Supabase gives you these under Project Settings -> API.
# Newer projects label them "Publishable" and "Secret"; older ones say
# "anon public" and "service_role". They are the same two things.

# Project URL, e.g. https://abcdefghijkl.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The anon / publishable key (a long string starting eyJ... or sb_publishable_...).
# This one is DESIGNED to be public. It ships inside the app binary and anyone
# can read it out. It is safe precisely because row-level security decides what
# it can touch, which is why the RLS policies are the first thing to build.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
